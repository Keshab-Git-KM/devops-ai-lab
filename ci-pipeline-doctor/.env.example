# ── AI CI/CD Pipeline Doctor — configuration ──
# Copy this file to `.env` and fill in values as needed.
# With the defaults below, the app runs fully offline and free:
# the heuristic engine handles known failures, and (in hybrid mode) an LLM is
# used ONLY when no pattern matches — which needs a key you can add for free.

# Analyzer provider: heuristic | hybrid | gemini | groq
#   heuristic = offline rules only (no key, no network)
#   hybrid    = rules first (free/instant), LLM fallback only if a key is set
DOCTOR_PROVIDER=hybrid

# ── Free LLM keys (optional) ──
# Groq is recommended: free, fast, no credit card → https://console.groq.com/keys
DOCTOR_GROQ_API_KEY=
DOCTOR_GROQ_MODEL=llama-3.3-70b-versatile
# Google Gemini free tier → https://aistudio.google.com/apikey
DOCTOR_GEMINI_API_KEY=
DOCTOR_GEMINI_MODEL=gemini-1.5-flash

# ── History / persistence (SQLite, local file) ──
DOCTOR_DB_PATH=data/doctor.db
DOCTOR_ENABLE_HISTORY=true

# ── GitHub integration (only for live webhook mode) ──
DOCTOR_GITHUB_WEBHOOK_SECRET=
DOCTOR_GITHUB_TOKEN=
